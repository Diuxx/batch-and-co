<dialog id="identity-conflict-dialog" class="identity-conflict-dialog" aria-labelledby="identity-conflict-title">
  <div class="dialog-body">
    <h2 id="identity-conflict-title">Synchronisation Google Drive</h2>
    <p id="identity-conflict-message" class="dialog-desc"></p>
    <p class="identity-warning">Cette action remplace intégralement la version choisie. Aucun mélange automatique des recettes ou plannings.</p>
    <div class="identity-choices">
      <button id="identity-pull" class="button" type="button">Récupérer Drive</button>
      <button id="identity-push" class="button primary" type="button">Envoyer la version locale</button>
      <button id="identity-cancel" class="button ghost" type="button">Annuler</button>
    </div>
  </div>
</dialog>
