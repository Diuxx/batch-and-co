<header class="topbar">
  <div class="brand"><div class="logo" aria-hidden="true">◒</div><div><div class="brand-title">batch<span>&</span>co.</div><div class="brand-caption">Planifier · Cuisiner · Économiser</div></div></div>
  <div class="top-actions">
    <span id="save-status" class="status">Données locales</span>
    <button id="btn-export" class="button" type="button">↓ Exporter</button>
    <button id="btn-import" class="button" type="button">↑ Importer</button>
    <input id="file-import" class="sr-only" type="file" accept=".json,application/json">
    <button id="btn-catalog" class="button ghost" type="button">Ingrédients</button>
    <div class="identity-header">
      <span id="identity-status" class="identity-status" role="status" aria-live="polite">Vérification…</span>
      <details id="profile-menu" class="profile-menu">
        <summary id="profile-trigger" class="profile-trigger" aria-label="Compte et sauvegardes" title="Compte et sauvegardes">
          <img id="profile-picture" class="profile-avatar" alt="" hidden>
          <span id="profile-initials" class="profile-avatar profile-fallback" aria-hidden="true">?</span>
        </summary>
        <div class="profile-panel">
          <div class="profile-heading">
            <strong id="profile-name">Vérification de la session…</strong>
            <small id="profile-email">Connexion via Nicolabz Identity</small>
            <span id="profile-drive">Données locales</span>
          </div>
          <div class="profile-separator"></div>
          <button id="profile-import" class="profile-action" type="button">↑ Importer un fichier JSON</button>
          <button id="profile-export" class="profile-action" type="button">↓ Exporter une sauvegarde</button>
          <button id="profile-sync" class="profile-action" type="button" hidden>↻ Synchroniser le planning</button>
          <div class="profile-separator"></div>
          <button id="profile-login" class="profile-action" type="button">Connexion Google</button>
          <button id="profile-consent" class="profile-action" type="button" hidden>☁ Autoriser Google Drive</button>
          <button id="profile-refresh" class="profile-action" type="button">↻ Actualiser la connexion</button>
          <button id="profile-logout" class="profile-action profile-danger" type="button" hidden>Se déconnecter</button>
        </div>
      </details>
    </div>
  </div>
</header>
